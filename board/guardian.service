# Start Guardian at boot as a user service (no sudo needed; the board's `arduino` user has
# linger enabled, so user services start without a login). Install on the board:
#   mkdir -p ~/.config/systemd/user && cp ~/guardian/board/guardian.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now guardian
# Logs: journalctl --user -u guardian -f
[Unit]
Description=Guardian fall alert (camera + mic triggers, InternVL3 on the NPU)
After=network-online.target pipewire.service

[Service]
WorkingDirectory=%h/guardian/board
ExecStart=%h/guardian/board/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
